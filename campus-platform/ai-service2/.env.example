# ─────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────────
# MongoDB Configuration
# ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/campus-image-analysis

# ─────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# Roboflow API Configuration
# ─────────────────────────────────────────────
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=your_workspace_id
ROBOFLOW_MODEL_ID=your_model_id
ROBOFLOW_MODEL_VERSION=1
ROBOFLOW_WORKFLOW_ID=your_workflow_id

# ─────────────────────────────────────────────
# Cloudinary Configuration (Optional)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
USE_CLOUDINARY=false

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
UPLOAD_RATE_LIMIT_MAX=20

# ─────────────────────────────────────────────
# Image Validation
# ─────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
MIN_IMAGE_QUALITY_SCORE=30
BLUR_THRESHOLD=100
CONFIDENCE_THRESHOLD=0.6

# ─────────────────────────────────────────────
# Cleanup Job
# ─────────────────────────────────────────────
CLEANUP_INTERVAL_HOURS=24
ORPHAN_FILE_AGE_HOURS=48
