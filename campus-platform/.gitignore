# ─── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/install-state.gz
.yarn/build-state.yml
.yarn/unplugged
.pnpm-store/

# ─── Lockfile churn helpers ───────────────────────────────────────────────────
# (lockfiles themselves are intentionally tracked; ignore only their transient
# helpers)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Build / output ────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.tsbuildinfo
*.tsbuildinfo

# ─── Native build artifacts (canvas, sharp, node-gyp, etc.) ───────────────────
**/build/Release/
**/build/Debug/
**/build/binding.Makefile
**/build/canvas.target.mk
**/build/gyp-mac-tool
**/*.node
**/prebuilds/

# ─── React Native / Expo ──────────────────────────────────────────────────────
.expo/
.expo-shared/
android/
ios/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ─── Metro / bundler caches ───────────────────────────────────────────────────
.metro-cache/
.metro-health-check*

# ─── Coverage / tests ─────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ─── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ─── Env & secrets ────────────────────────────────────────────────────────────
# Env files often contain credentials (MONGO_URI, JWT_SECRET, API keys).
# Use env.example / .env.example to share variable *names* with collaborators.
.env
.env.*
!.env.example
!env.example

# ─── Misc ──────────────────────────────────────────────────────────────────────
*.tmp
*.temp
*.pid
*.seed
*.pid.lock
